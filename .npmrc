# legacy-peer-deps: this project intentionally runs two peer combinations npm
# would otherwise reject:
#   - jaml-ui@4.6 peers motely-wasm ^25.1, we run motely-wasm 26 (JamlView drives
#     the engine directly and does not use jaml-ui's removed scoreList path)
#   - @json-render/react peers React 19, this app is on React 18
# Both are deliberate and verified working; keep this scoped by removing it once
# jaml-ui ships a motely-wasm 26 / React 18 compatible release.
legacy-peer-deps=true
